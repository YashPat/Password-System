/* Palette
   background #12111a   panel #1b1a27   border #2e2b40
   text #e6e4f0   muted #8b87a6
   mint #7ee8b5   violet #b39cf5   pink #f59ac0   peach #f9b98a */

Screen {
    background: #12111a;
    color: #e6e4f0;
    align: center middle;
}

Center {
    height: auto;
}

.panel {
    width: 64;
    height: auto;
    background: #1b1a27;
    border: round #2e2b40;
    padding: 2 4;
}

.title {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #7ee8b5;
}

.subtitle {
    width: 100%;
    text-align: center;
    color: #8b87a6;
    margin-bottom: 2;
}

.footer-hint {
    width: 100%;
    text-align: center;
    color: #8b87a6;
    margin-top: 2;
}

/* Menu */

.option {
    height: auto;
    margin-bottom: 1;
}

.option Button {
    width: 1fr;
}

.option .hint {
    width: 8;
    height: 3;
    content-align: right middle;
    color: #8b87a6;
}

/* Buttons */

Button {
    background: #24223a;
    color: #e6e4f0;
    border: tall #24223a;
    text-style: bold;
}

Button:hover {
    background: #2e2b48;
}

Button.mint:focus {
    background: #7ee8b5;
    color: #12111a;
    border: tall #7ee8b5;
}

Button.violet:focus {
    background: #b39cf5;
    color: #12111a;
    border: tall #b39cf5;
}

Button.pink:focus {
    background: #f59ac0;
    color: #12111a;
    border: tall #f59ac0;
}

Button.peach:focus {
    background: #f9b98a;
    color: #12111a;
    border: tall #f9b98a;
}

.violet-text {
    color: #b39cf5;
}

.actions {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.actions Button {
    margin-left: 2;
}

/* Recover input */

#keys {
    height: 9;
    background: #12111a;
    border: round #2e2b40;
}

#keys:focus {
    border: round #b39cf5;
}

#error {
    color: #f59ac0;
    height: auto;
    margin-top: 1;
}

/* Computing */

#computing-panel {
    width: 72;
    padding: 2 6;
}

#bar {
    width: 100%;
    margin-top: 1;
}

#bar Bar {
    width: 1fr;
}

#percent {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: #e6e4f0;
    margin-top: 1;
    margin-bottom: 2;
}

.stat {
    height: 1;
    margin-bottom: 1;
}

.stat-name {
    width: 1fr;
    color: #8b87a6;
}

.stat-value {
    width: auto;
    text-style: bold;
}

#speed { color: #7ee8b5; }
#elapsed { color: #b39cf5; }
#left { color: #f9b98a; }
#finish { color: #f59ac0; }

/* Result */

#result-panel {
    width: 76;
}

.label {
    color: #8b87a6;
    margin-top: 1;
}

.secret-row {
    height: auto;
    margin-top: 1;
}

.secret {
    width: 1fr;
    height: auto;
    padding: 1 2;
    background: #12111a;
    border: round #2e2b40;
    color: #7ee8b5;
    text-style: bold;
}

.secret.keys {
    color: #b39cf5;
    text-style: none;
}

.secret-row Button {
    margin-left: 2;
    min-width: 10;
}

.warning {
    color: #f9b98a;
    margin-top: 1;
}
